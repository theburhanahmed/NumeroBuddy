{
  "inputs": [
    "birth_year",
    "gender"
  ],
  "calculations": [
    {
      "name": "kua_number",
      "formula": "if gender == 'female' then reduce_to_single_digit(sum_of_digits(birth_year) + 4) else 11 - reduce_to_single_digit(sum_of_digits(birth_year))"
    }
  ],
  "conditions": [
    {
      "id": "kua_group",
      "if": "kua_number in [1, 3, 4, 9] || (kua_number == 5 && gender == 'male')",
      "then": "East group",
      "else": "West group"
    }
  ],
  "outputs": [
