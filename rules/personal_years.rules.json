{
  "inputs": [
    "birth_day",
    "birth_month",
    "current_year",
    "birth_year",
    "driver_number"
  ],
  "calculations": [
    {
      "name": "universal_year",
      "formula": "reduce_to_single_digit(current_year)"
    },
    {
      "name": "personal_year",
      "formula": "reduce_to_single_digit(reduce_to_single_digit(current_year) + reduce_to_single_digit(birth_day + birth_month))"
    },
    {
      "name": "running_age",
      "formula": "current_year - birth_year"
    },
    {
      "name": "personal_month",
      "formula": "reduce_to_single_digit(month_index + personal_year)"
    }
  ],
  "conditions": [
    {
      "id": "double_strength_success_year",
      "if": "is_personal_year_good(personal_year, driver_number) && is_age_good(running_age, driver_number)",
      "then": "double_strength_success_year",
      "symbol": "**"
    },
    {
      "id": "year_of_contradiction",
      "if": "is_age_good(running_age, driver_number) && !is_personal_year_good(personal_year, driver_number)",
      "then": "year_of_contradiction",
      "symbol": "*0"
    },
    {
      "id": "year_of_caution",
      "if": "!is_age_good(running_age, driver_number) && !is_personal_year_good(personal_year, driver_number)",
      "then": "year_of_caution",
      "symbol": "00"
    }
  ],
