{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      }
    ],
    "routes": [
      { "src": "/favicon\\.ico", "dest": "/favicon.svg" },
      { "src": "/assets/(.*)", "dest": "/assets/$1" },
      { "src": "/(.*\\..*)", "dest": "/$1" },
      { "src": "/(.*)", "dest": "/index.html" }
    ]
  }